# --- Supabase (required) ----------------------------------------------------
# From your Supabase project: Settings → API. The publishable key (sb_publishable_…)
# or the legacy anon key both work for NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role / secret key — server-only, NEVER exposed with NEXT_PUBLIC_.
# Used only by Team → "Add team member" to create a teammate's login.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (required for Extract & draft, Suggest) ---------------------
# Server-side only. The model is chosen by the admin under AI Playbook.
ANTHROPIC_API_KEY=

# --- HubSpot (Phase 4 — not wired up yet) -----------------------------------
# HUBSPOT_PRIVATE_APP_TOKEN=
