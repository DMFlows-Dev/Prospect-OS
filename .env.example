# --- Supabase (required for Phase 1) ---------------------------------------
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, NEVER exposed with NEXT_PUBLIC_. Needed
# once Team invites use Supabase's admin API instead of "sign in once, then
# get activated by an Admin". Not required for Phase 1 as scaffolded.
# SUPABASE_SERVICE_ROLE_KEY=

# --- HubSpot (Phase 4 — not wired up yet) -----------------------------------
# Same variable name as dmflows_leadgen/.env, so the existing private-app
# token can be copied over directly when this phase starts.
# HUBSPOT_PRIVATE_APP_TOKEN=

# --- Claude API (Phase 2 — AI research & drafting, not wired up yet) -------
# ANTHROPIC_API_KEY=
